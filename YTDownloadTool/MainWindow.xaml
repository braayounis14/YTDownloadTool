<Window x:Class="YTDownloadTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YTDownloadTool"
        mc:Ignorable="d"
        Title="YTDownloadTool" Height="740" Width="1160"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D15">

    <Window.Resources>
        <Style x:Key="LogoText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        </Style>

        <SolidColorBrush x:Key="AccentBlue" Color="#00D2FF" />
        <SolidColorBrush x:Key="AccentPink" Color="#E91E63" />

        <Style x:Key="SFIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <LinearGradientBrush x:Key="MainBgGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0D15" Offset="0" />
            <GradientStop Color="#1A1A2E" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Background="{StaticResource MainBgGradient}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="15" CornerRadius="25" Background="#10FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1">
            <StackPanel Margin="25">
                <TextBlock Text="YT PRO" Style="{StaticResource LogoText}" Margin="0,20,0,40"/>

                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,5" Click="Downloads_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="190">
                        <TextBlock Text="&#xE896;" Style="{StaticResource SFIcon}" Foreground="White" FontSize="18" Margin="0,0,15,0"/>
                        <TextBlock Text="Downloads" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,15" Click="Library_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Width="190">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource SFIcon}" Foreground="#999" FontSize="18" Margin="0,0,15,0"/>
                        <TextBlock Text="Library" Foreground="#999" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame"
               Grid.Column="1"
               Margin="10,20,25,20"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
