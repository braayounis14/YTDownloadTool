<Window x:Class="YTDownloadTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:YTDownloadTool.Views"
        Title="Tidejar - Video &amp; Stream Saver"
        Height="780" Width="1200"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D15">

    <Grid Background="{StaticResource MainBgGradient}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Glass Sidebar -->
        <Border Grid.Column="0" Margin="16" CornerRadius="22" Background="#12FFFFFF" BorderBrush="#1CFFFFFF" BorderThickness="1">
            <DockPanel Margin="18">
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="6,10,6,28">
                    <TextBlock Text="TIDEJAR" Foreground="White" FontSize="24" FontWeight="Black" Typography.Capitals="AllSmallCaps" />
                    <TextBlock Text="Video &amp; Stream Saver" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding AppVersionLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Bottom Engine & App Update Status -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <!-- App Update Ready Banner -->
                    <Border Visibility="{Binding IsAppUpdateReady, Converter={StaticResource BoolToVis}}"
                            Background="#2400D2FF" BorderBrush="#6600D2FF" BorderThickness="1"
                            CornerRadius="12" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding AppUpdateBannerText}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Button Content="Restart &amp; Update" Command="{Binding RestartToApplyAppUpdateCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Multimedia Engine Status Pill -->
                    <Border Background="#16000000" BorderBrush="#1EFFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="{Binding EngineStatusColor}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding EngineStatusText}" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="165" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel>
                    <Button Command="{Binding SelectDownloadsCommand}" Style="{StaticResource NavButton}" Margin="0,4">
                        <Button.Background>
                            <SolidColorBrush Color="#00000000" />
                        </Button.Background>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource SFIcon}" FontSize="17" Margin="0,0,14,0"
                                       Foreground="{StaticResource AccentBlue}" />
                            <TextBlock Text="Downloads" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectLibraryCommand}" Style="{StaticResource NavButton}" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" Style="{StaticResource SFIcon}" FontSize="17" Margin="0,0,14,0"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectSettingsCommand}" Style="{StaticResource NavButton}" Margin="0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource SFIcon}" FontSize="17" Margin="0,0,14,0"
                                       Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="Settings &amp; Engine" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area (persists all views cleanly without losing active download state) -->
        <Grid Grid.Column="1" Margin="4,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Non-crashing Database Recovery Notice Banner (shown only if a schema migration rolled back to backup) -->
            <Border Grid.Row="0"
                    Visibility="{Binding DatabaseRecoveryNotice, Converter={StaticResource StrToVis}}"
                    Background="#28D29922" BorderBrush="#88D29922" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="8,0,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding DatabaseRecoveryNotice}" Foreground="#F5D076"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissDatabaseRecoveryNoticeCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:DownloadsView DataContext="{Binding Downloads}"
                                     Visibility="{Binding DataContext.IsDownloadsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <views:LibraryView DataContext="{Binding Library}"
                                   Visibility="{Binding DataContext.IsLibrarySelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
