<UserControl x:Class="YTDownloadTool.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:YTDownloadTool.Core.Settings;assembly=YTDownloadTool.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,12,12">
        <StackPanel>
            <!-- Page Header -->
            <TextBlock Text="New Download" Foreground="White" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Paste any YouTube video, Shorts, or active livestream URL to inspect real available qualities."
                       Foreground="{StaticResource SubtleTextBrush}" FontSize="13" Margin="0,4,0,18" />

            <!-- URL Input Bar -->
            <Border CornerRadius="16" Background="#14FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE71B;" Style="{StaticResource SFIcon}" FontSize="18"
                               Foreground="{StaticResource AccentBlue}" Margin="4,0,12,0" />

                    <TextBox x:Name="UrlTextBox" Grid.Column="1"
                             Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                             FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"
                             KeyDown="UrlTextBox_KeyDown" />

                    <Button Grid.Column="2" Content="PASTE" Command="{Binding PasteUrlCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />

                    <Button Grid.Column="3" Command="{Binding AnalyzeUrlCommand}" Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsProbing, Converter={StaticResource InvBool}}" MinWidth="128">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource SFIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="ANALYZE" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Probing Progress Indicator -->
            <StackPanel Visibility="{Binding IsProbing, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <ProgressBar Style="{StaticResource ModernProgressBar}" IsIndeterminate="True" Height="5" />
                <TextBlock Text="Inspecting video formats and stream availability..."
                           Foreground="{StaticResource AccentBlue}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Probe / Validation Error Banner -->
            <Border Visibility="{Binding ProbeErrorMessage, Converter={StaticResource StrToVis}}"
                    Background="#28DA3633" BorderBrush="#88DA3633" BorderThickness="1"
                    CornerRadius="12" Padding="14,10" Margin="0,12,0,0">
                <TextBlock Text="{Binding ProbeErrorMessage}" Foreground="#FFB4B1" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <!-- Analyzed Media Preview & Options Card -->
            <Border Visibility="{Binding HasProbedMedia, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                <StackPanel>
                    <!-- Media Metadata Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail with Clean Rounded Clip -->
                        <Border Grid.Column="0" Width="188" Height="106" CornerRadius="10" Background="#121222" ClipToBounds="True" VerticalAlignment="Top">
                            <Image Source="{Binding ProbedMedia.ThumbnailUrl}" Stretch="UniformToFill" />
                        </Border>

                        <!-- Title, Channel, Content Type Badge -->
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Background="{Binding ContentBadgeColor}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding ProbedMedia.ContentTypeBadge}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding ProbedDurationText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding ProbedMedia.Title}" Foreground="White" FontSize="18" FontWeight="Bold"
                                       TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ProbedMedia.Channel}" Foreground="{StaticResource AccentBlue}" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Livestream Mode Selector (Shown ONLY for Active Livestreams) -->
                    <Border Visibility="{Binding IsActiveLivestream, Converter={StaticResource BoolToVis}}"
                            Background="#1C000000" BorderBrush="#28E91E63" BorderThickness="1"
                            CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="LIVESTREAM RECORDING MODE" Foreground="#FF7CA3" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton GroupName="LiveMode" Foreground="White" FontSize="13" Margin="0,0,18,0"
                                             IsChecked="{Binding SelectedLivestreamMode, Converter={StaticResource EnumEquals}, ConverterParameter=RecordFromNow}"
                                             Content="Mode A — Record from now until end" />

                                <RadioButton GroupName="LiveMode" Foreground="White" FontSize="13" Margin="0,0,18,0"
                                             IsEnabled="{Binding IsDvrAvailable}"
                                             IsChecked="{Binding SelectedLivestreamMode, Converter={StaticResource EnumEquals}, ConverterParameter=RecordFromStartUntilEnd}"
                                             Content="Mode B — From start until end (DVR)" />

                                <RadioButton GroupName="LiveMode" Foreground="White" FontSize="13"
                                             IsEnabled="{Binding IsDvrAvailable}"
                                             IsChecked="{Binding SelectedLivestreamMode, Converter={StaticResource EnumEquals}, ConverterParameter=RecordFromStartToLiveEdge}"
                                             Content="Mode C — From start, stop near live edge" />
                            </StackPanel>

                            <!-- Mode C Live-Edge Margin Selector -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsModeCSelected, Converter={StaticResource BoolToVis}}" Margin="0,4,0,8">
                                <TextBlock Text="Stop distance before live edge (seconds):" Foreground="{StaticResource SubtleTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox ItemsSource="{Binding LiveEdgeMarginPresets}" SelectedItem="{Binding LiveEdgeMarginSeconds}"
                                          Style="{StaticResource DarkComboBox}" Width="90" />
                                <TextBlock Text="(Recommended: 30s)" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedModeExplanation}" Foreground="{StaticResource SubtleTextBrush}"
                                       FontSize="12" TextWrapping="Wrap" />

                            <!-- DVR Availability / Window Cap Notice -->
                            <Border Visibility="{Binding DvrBannerMessage, Converter={StaticResource StrToVis}}"
                                    Background="#28D29922" BorderBrush="#88D29922" BorderThickness="1"
                                    CornerRadius="8" Padding="10,7" Margin="0,10,0,0">
                                <TextBlock Text="{Binding DvrBannerMessage}" Foreground="#F5D076" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Quality, Format, Destination & Start Action Row -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="QUALITY (AVAILABLE FORMATS)" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedQuality}"
                                      DisplayMemberPath="Label" Style="{StaticResource DarkComboBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FORMAT" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                            <ComboBox ItemsSource="{Binding AvailableContainers}" SelectedItem="{Binding SelectedContainer}"
                                      Style="{StaticResource DarkComboBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SAVE TO" Foreground="{StaticResource MutedTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputDirectory}" IsReadOnly="True" Style="{StaticResource DarkTextBox}" Padding="10,7" FontSize="12" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseOutputFolderCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="10,6" ToolTip="Choose folder" />
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="6" Command="{Binding StartDownloadCommand}" IsEnabled="{Binding CanStartDownload}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" MinWidth="150" Height="38">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource SFIcon}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding StartButtonText}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active & Recent Downloads Header -->
            <DockPanel Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}" Margin="0,24,0,10">
                <TextBlock Text="ACTIVE &amp; RECENT DOWNLOADS" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Content="Clear Finished" Command="{Binding ClearFinishedJobsCommand}"
                        Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="12,5" FontSize="11" />
            </DockPanel>

            <!-- Jobs Queue List -->
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="16" Background="#16FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Thumbnail, Title, Badges & Action Buttons -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="96" Height="56" CornerRadius="8" Background="#10101D" ClipToBounds="True" VerticalAlignment="Top">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{Binding StatusBadgeColor}" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding StateLabel}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding LivestreamModeBadge}" Foreground="{StaticResource AccentBlue}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding ContainerBadge}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="{Binding CancelButtonText}" Command="{Binding CancelOrStopCommand}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource DangerButton}" Margin="0,0,6,0" />

                                        <Button Content="RETRY" Command="{Binding RetryCommand}"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />

                                        <Button Content="PLAY" Command="{Binding PlayFileCommand}"
                                                Visibility="{Binding HasFileOutput, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />

                                        <Button Content="OPEN FOLDER" Command="{Binding OpenFolderCommand}"
                                                Style="{StaticResource SecondaryButton}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Metrics & Phase -->
                                <Grid Grid.Row="1" Margin="0,12,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding PhaseLabel}" Foreground="#D8DCEB" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="SIZE" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="{Binding SizeText}" Foreground="White" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SPEED" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="{Binding SpeedText}" Foreground="White" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="{Binding EtaHeaderText}" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" />
                                        <TextBlock Text="{Binding EtaOrDurationText}" Foreground="White" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Full-Width Responsive ProgressBar -->
                                <ProgressBar Grid.Row="2" Style="{StaticResource ModernProgressBar}"
                                             Value="{Binding Percentage}" IsIndeterminate="{Binding IsIndeterminate}" />

                                <!-- Row 3: Non-Fatal Notice or Error + Expandable Diagnostics -->
                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding NonFatalNotice}"
                                               Visibility="{Binding NonFatalNotice, Converter={StaticResource StrToVis}}"
                                               Foreground="#F5D076" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />

                                    <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StrToVis}}"
                                            Background="#24DA3633" BorderBrush="#66DA3633" BorderThickness="1" CornerRadius="8" Padding="10,7">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button Content="Details" Command="{Binding ToggleDiagnosticsCommand}" DockPanel.Dock="Right"
                                                        Style="{StaticResource SecondaryButton}" Padding="8,3" FontSize="10" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB4B1" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True"
                                                     Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVis}}"
                                                     Background="#18000000" Foreground="#CCC" BorderThickness="0"
                                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxHeight="110"
                                                     VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="6" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
