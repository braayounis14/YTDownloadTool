<UserControl x:Class="YTDownloadTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,12,16">
        <StackPanel>
            <TextBlock Text="Settings &amp; Engine" Foreground="White" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Configure downloads, livestream defaults, automatic engine updates, and licenses."
                       Foreground="{StaticResource SubtleTextBrush}" FontSize="13" Margin="0,4,0,18" />

            <!-- General Preferences Card -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD &amp; LIVESTREAM PREFERENCES" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Default Download Folder" Foreground="White" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DownloadDirectory}" Style="{StaticResource DarkTextBox}" />
                        <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseDefaultFolderCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preferred Quality" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding DefaultQuality}" Style="{StaticResource DarkComboBox}" />
                        <TextBlock Grid.Column="3" Text="Default Container" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding ContainerOptions}" SelectedItem="{Binding DefaultContainer}" Style="{StaticResource DarkComboBox}" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Concurrent Downloads" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ConcurrencyOptions}" SelectedItem="{Binding MaxConcurrentDownloads}" Style="{StaticResource DarkComboBox}" />
                        <TextBlock Grid.Column="3" Text="Mode C Live-Edge Margin (s)" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="4" ItemsSource="{Binding LiveMarginOptions}" SelectedItem="{Binding LiveEdgeMarginSeconds}" Style="{StaticResource DarkComboBox}" />
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="yt-dlp Release Channel" Foreground="White" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding YtDlpChannelOptions}" SelectedItem="{Binding YtDlpChannel}" Style="{StaticResource DarkComboBox}" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                            <CheckBox Content="Auto-update multimedia engine" IsChecked="{Binding AutoUpdateTools}" Foreground="White" Margin="0,0,18,0" />
                            <CheckBox Content="Auto-check app updates" IsChecked="{Binding AutoCheckAppUpdates}" Foreground="White" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" />
                        <TextBlock Text="{Binding SaveFeedback}" Foreground="{StaticResource AccentGreen}" FontSize="13"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Managed Multimedia Engine Card (yt-dlp, FFmpeg, Deno) -->
            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="MULTIMEDIA ENGINE (MANAGED AUTOMATICALLY)" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="yt-dlp, FFmpeg/FFprobe, and Deno are verified via SHA-256 and updated independently without manual setup."
                                       Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Content="Check Engine Updates" Command="{Binding CheckEngineUpdatesCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="{Binding EngineActionFeedback}"
                               Visibility="{Binding EngineActionFeedback, Converter={StaticResource StrToVis}}"
                               Foreground="{StaticResource AccentBlue}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" />

                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#18000000" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" />
                                                <Border Background="{Binding StateBadgeColor}" CornerRadius="5" Padding="7,2">
                                                    <TextBlock Text="{Binding State}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,0">
                                                <Run Text="Installed: " />
                                                <Run Text="{Binding InstalledVersion}" Foreground="White" />
                                                <Run Text="  •  " />
                                                <Run Text="{Binding StatusMessage}" />
                                            </TextBlock>
                                            <ProgressBar Style="{StaticResource ModernProgressBar}" Value="{Binding DownloadProgress}" Height="5" Margin="0,8,16,0"
                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Update" Command="{Binding UpdateCommand}"
                                                    Style="{StaticResource PrimaryButton}" Padding="12,6" FontSize="12" Margin="0,0,6,0" />
                                            <Button Content="Rollback" Command="{Binding RollbackCommand}"
                                                    Visibility="{Binding CanRollback, Converter={StaticResource BoolToVis}}"
                                                    Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" />
                                            <Button Content="Repair" Command="{Binding RepairCommand}"
                                                    Style="{StaticResource SecondaryButton}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Application Updates, Diagnostics & Open-Source Licenses -->
            <Border Style="{StaticResource GlassCard}">
                <StackPanel>
                    <TextBlock Text="APPLICATION UPDATES, LOGS &amp; LICENSES" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding AppVersionText}" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AppUpdateStatusText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Restart &amp; Update" Command="{Binding ApplyAppUpdateNowCommand}"
                                    Visibility="{Binding IsAppUpdateReadyToRestart, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                            <Button Content="Check App Updates" Command="{Binding CheckAppUpdatesCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                            <Button Content="Open-Source Licenses" Command="{Binding ToggleNoticesCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBox Text="{Binding ThirdPartyNoticesText, Mode=OneWay}" IsReadOnly="True"
                             Visibility="{Binding ShowNotices, Converter={StaticResource BoolToVis}}"
                             Background="#1A000000" Foreground="#D4D8E8" BorderBrush="#24FFFFFF" BorderThickness="1"
                             FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxHeight="260"
                             VerticalScrollBarVisibility="Auto" Padding="12" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
