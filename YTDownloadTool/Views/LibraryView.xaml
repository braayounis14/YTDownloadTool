<UserControl x:Class="YTDownloadTool.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="8,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Library" Foreground="White" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Completed downloads, saved livestream recordings, and ffprobe integrity verification."
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Clear History" Command="{Binding ClearHistoryCommand}" Style="{StaticResource DangerButton}" />
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                 ToolTip="Search by title, channel, format, or integrity status" />

        <!-- Verification / Repair Action Feedback Banner -->
        <Border Grid.Row="2"
                Visibility="{Binding ActionFeedback, Converter={StaticResource StrToVis}}"
                Background="#2000D2FF" BorderBrush="#5500D2FF" BorderThickness="1"
                CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <TextBlock Text="{Binding ActionFeedback}" Foreground="#CBEFFF" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Empty State -->
        <StackPanel Grid.Row="3" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xE8F1;" Style="{StaticResource SFIcon}" FontSize="48" Foreground="#44FFFFFF" Margin="0,0,0,10" />
            <TextBlock Text="No downloaded videos in history yet" Foreground="{StaticResource MutedTextBrush}" FontSize="16" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Library List -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
            <ItemsControl ItemsSource="{Binding FilteredItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="14" Background="#14FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Row 0: Thumbnail + Full-Width Title & Metadata -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Width="104" Height="60" CornerRadius="8" Background="#10101D" ClipToBounds="True" VerticalAlignment="Top">
                                        <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                        <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{Binding IntegrityBadgeColor}" CornerRadius="5" Padding="6,2" Margin="0,0,10,2"
                                                    ToolTip="{Binding IntegrityTooltip}">
                                                <TextBlock Text="{Binding IntegrityBadgeText}" Foreground="White" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding Channel}" Foreground="{StaticResource AccentBlue}" FontSize="12" Margin="0,0,10,2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BadgeText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,0,10,2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Container}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,0,10,2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MediaSpecsSummary}"
                                                       Visibility="{Binding MediaSpecsSummary, Converter={StaticResource StrToVis}}"
                                                       Foreground="#C4CBE0" FontSize="11" Margin="0,0,10,2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileSizeText}" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,0,10,2" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CompletedAtText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,2" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Full-Width Action Buttons Row (never competes with title or metadata) -->
                                <WrapPanel Orientation="Horizontal" Margin="130,8,0,0">
                                    <Button Content="Play" Command="{Binding PlayCommand}" IsEnabled="{Binding FileExists}"
                                            Style="{StaticResource PrimaryButton}" Padding="12,5" FontSize="12" Margin="0,2,6,2" />
                                    <Button Content="{Binding VerifyButtonText}" Command="{Binding VerifyOrRepairCommand}" IsEnabled="{Binding CanVerify}"
                                            Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,2,6,2"
                                            ToolTip="Verify file with ffprobe and losslessly repair container metadata if needed" />
                                    <Button Content="Reveal" Command="{Binding ShowInExplorerCommand}"
                                            Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,2,6,2" />
                                    <Button Content="Copy URL" Command="{Binding CopyUrlCommand}"
                                            Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" Margin="0,2,6,2" />
                                    <Button Content="Remove" Command="{Binding RemoveFromHistoryCommand}"
                                            Style="{StaticResource DangerButton}" Padding="10,5" FontSize="11" Margin="0,2,0,2" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
