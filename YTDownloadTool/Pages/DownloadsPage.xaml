<Page x:Class="YTDownloadTool.Pages.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:vm="clr-namespace:YTDownloadTool.ViewModels"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YTDownloadTool.Pages" 
      mc:Ignorable="d" 
      Background="Transparent"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="DownloadsPage">


    <Page.Resources>
        <SolidColorBrush x:Key="AccentGreen" Color="#4CC717"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#00D2FF"/>
        <SolidColorBrush x:Key="AccentPink" Color="#FF2E63"/>
        <SolidColorBrush x:Key="MenuBackground" Color="#252525"/>
        <SolidColorBrush x:Key="MenuHover" Color="#353535"/>

        <Style x:Key="LocalIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="IOSSwitch" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent" Cursor="Hand" Height="24" Width="44">
                            <Border x:Name="Border" CornerRadius="12" Background="#444" BorderThickness="0">
                                <Ellipse x:Name="Dot" Width="18" Height="18" HorizontalAlignment="Left" Margin="3" Fill="White">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.3" Direction="270"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentGreen}"/>
                                <Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" Padding="12,8" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <ContentPresenter ContentSource="Header" Grid.Column="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Arrow" Text="&#xE76C;" Grid.Column="3" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" 
                                           FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Foreground="#999"/>

                                <Popup x:Name="Popup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{StaticResource MenuBackground}" BorderThickness="1" BorderBrush="#333" CornerRadius="8" Margin="5,0,0,0" Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource MenuHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTopMenu" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="10,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,2,0,0" VerticalAlignment="Center" Opacity="0.7"/>
                                </StackPanel>
                                <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Border Background="{StaticResource MenuBackground}" BorderThickness="1" BorderBrush="#333" CornerRadius="8" Margin="0,5,0,0" Padding="5">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True" Grid.IsSharedSizeScope="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Grid.Column="1" Margin="30,40,40,40" Grid.ColumnSpan="2">
        <StackPanel>
            <TextBlock Text="New Download" Foreground="White" FontSize="32" FontWeight="Bold"/>

            <Border Margin="0,20,0,0" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
                        <CheckBox Style="{StaticResource IOSSwitch}" IsChecked="True"/>
                        <TextBlock Text="&#xE945;" Style="{StaticResource LocalIcon}" Foreground="White" Margin="10,0,0,0" FontSize="14" ToolTip="Smart Mode"/>
                    </StackPanel>

                    <Menu Background="Transparent">
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>

                        <MenuItem Header="Download Video" Style="{StaticResource ModernTopMenu}">
                            <MenuItem Header="Video" Style="{StaticResource ModernMenuItem}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource LocalIcon}" Foreground="{StaticResource AccentGreen}"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Audio" Style="{StaticResource ModernMenuItem}"/>
                            <Separator Background="#333" Margin="5,2"/>
                            <MenuItem Header="Subtitles" Style="{StaticResource ModernMenuItem}">
                                <MenuItem Header="English" Style="{StaticResource ModernMenuItem}"/>
                                <MenuItem Header="Auto-Generated" Style="{StaticResource ModernMenuItem}"/>
                            </MenuItem>
                            <MenuItem Header="Audio tracks" Style="{StaticResource ModernMenuItem}"/>
                        </MenuItem>

                        <MenuItem Header="Quality Best" Style="{StaticResource ModernTopMenu}" Margin="10,0,0,0">
                            <MenuItem Header="Best (4K/8K)" Style="{StaticResource ModernMenuItem}"/>
                            <MenuItem Header="1080p" Style="{StaticResource ModernMenuItem}"/>
                            <MenuItem Header="720p" Style="{StaticResource ModernMenuItem}"/>
                        </MenuItem>

                        <MenuItem Header="For Windows" Style="{StaticResource ModernTopMenu}" Margin="10,0,0,0">
                            <MenuItem Header="MP4 (Windows)" Style="{StaticResource ModernMenuItem}"/>
                            <MenuItem Header="MKV" Style="{StaticResource ModernMenuItem}"/>
                            <MenuItem Header="WebM" Style="{StaticResource ModernMenuItem}"/>
                        </MenuItem>

                        <MenuItem Header="Save to Videos" Style="{StaticResource ModernTopMenu}" Margin="10,0,0,0"/>

                    </Menu>
                </StackPanel>
            </Border>
            <Border Margin="0,20,0,0" Height="70" CornerRadius="20" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE71B;" Style="{StaticResource LocalIcon}" FontSize="20" Foreground="{StaticResource AccentBlue}"/>

                    <TextBox Grid.Column="1" 
                           Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                           Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" 
                           VerticalAlignment="Center" Margin="15,0" CaretBrush="White" 
                           Opacity="0.8" />

                    <Button Command="{Binding StartDownloadCommand}"
                        Grid.Column="2" Width="120" Height="45" Background="{StaticResource AccentPink}" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="12"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource LocalIcon}" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="GET VIDEO" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <TextBlock Text="Last Video Downloaded" 
                   Visibility="{Binding StatusCardVisibility}"
                   Foreground="#666" Margin="0,40,0,15" FontWeight="Bold" FontSize="12"/>

            <Border Height="320" CornerRadius="25" ClipToBounds="True" BorderBrush="#20FFFFFF" BorderThickness="1"
            Visibility="{Binding StatusCardVisibility}" Margin="0,10,0,0">
                <Grid>
                    <Image Source="{Binding CurrentDownload.Thumbnail,TargetNullValue={x:Null}}" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="15"/>
                        </Image.Effect>
                    </Image>

                    <Border Background="Transparent"/>

                    <Grid Margin="25">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <DockPanel>
                                <TextBlock Text="{Binding CurrentDownload.Title}" DockPanel.Dock="Left"
                               Foreground="White" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="400"/>

                                <Button HorizontalAlignment="Right" Background="#20FFFFFF" BorderThickness="0" 
                               Padding="10,5" Cursor="Hand" Command="{Binding OpenFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" Style="{StaticResource LocalIcon}" Foreground="White" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="OPEN FOLDER" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>

                            <TextBlock Text="{Binding CurrentDownload.Metadata}" Foreground="{StaticResource AccentBlue}" Margin="0,5,0,0" FontSize="14"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="SPEED" Foreground="#666" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentDownload.Speed}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="ETA" Foreground="#666" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentDownload.Eta}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="STATUS" Foreground="#666" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CurrentDownload.Status}" Foreground="White" FontSize="14"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Grid.Row="2">
                            <Grid x:Name="ProgressBarBorder" Height="8">
                                <Border Background="#1AFFFFFF" CornerRadius="4"/>
                                <Border HorizontalAlignment="Left" 
                            Width="{Binding CurrentDownload.ProgressWidth}" 
                            CornerRadius="4" Background="{StaticResource AccentBlue}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>