<Page x:Class="YTDownloadTool.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YTDownloadTool.Pages"
      mc:Ignorable="d" 
      Background="Transparent"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPage">

        <Grid Grid.Column="1" Margin="20,40,40,40" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="New Download" Foreground="White" FontSize="32" FontWeight="Bold"/>

                <Border Margin="0,30,0,0" Height="70" CornerRadius="20" Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="&#xE71B;" Style="{StaticResource SFIcon}" FontSize="20" Foreground="{StaticResource AccentBlue}"/>

                        <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" 
                                 VerticalAlignment="Center" Margin="15,0" CaretBrush="White" 
                                 Opacity="0.8" Text="Paste YouTube link here..."/>

                        <Button Grid.Column="2" Width="120" Height="45" Background="{StaticResource AccentPink}" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource SFIcon}" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="GET VIDEO" Foreground="White" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="Last Video Downloaded" Foreground="#666" Margin="0,40,0,15" FontWeight="Bold" FontSize="12"/>

                <Border Height="300" CornerRadius="25" ClipToBounds="True" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Grid>
                        <Image Source="https://images.unsplash.com/photo-1614850523296-d8c1af93d400?q=80&amp;w=1000&amp;auto=format&amp;fit=crop" Stretch="UniformToFill">
                            <Image.Effect>
                                <BlurEffect Radius="2"/>
                            </Image.Effect>
                        </Image>

                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0.4" />
                                    <GradientStop Color="#CC000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid VerticalAlignment="Bottom" Margin="25">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Cyberpunk 2077 - Official Trailer" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="4K Ultra HD • 248MB • 03:45" Foreground="#AAA" Margin="0,5,0,15"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Height="6">
                                <Border Background="#33FFFFFF" CornerRadius="3"/>
                                <Border HorizontalAlignment="Left" Width="180" CornerRadius="3" Background="{StaticResource AccentBlue}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Grid>

                        <Border Width="70" Height="70" Background="#EEFFFFFF" CornerRadius="35" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE768;" Style="{StaticResource SFIcon}" Foreground="Black" FontSize="24" Margin="5,0,0,0"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
</Page>
