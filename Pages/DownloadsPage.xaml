<Page x:Class="YTDownloadTool.Pages.DownloadsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      xmlns:vm="clr-namespace:YTDownloadTool.ViewModels"
      Background="#0D0D15">


    <Page.DataContext>
        <vm:DownloadsPageViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2C2C44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A54"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ModernButton}"/>
        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF7C5CFF" Offset="0"/>
                        <GradientStop Color="#FFFF6B9D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#7C5CFF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF0F0F1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF16213E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF7C5CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0F0F1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF16213E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>


    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- INPUT BAR (taken from DashboardPageTest logic) -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}"/>

            <Button Grid.Column="1"
                    Content="START"
                    Command="{Binding DownloadCommand}"
                    Margin="10,0,0,0"/>
        </Grid>

        <!-- DOWNLOADS LIST -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Downloads}">
                <ItemsControl.ItemTemplate>

                    <!-- 🔥 THIS IS YOUR BIG CARD UI 🔥 -->
                    <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                        <Border Background="#FF1A1A2E" 
                                BorderBrush="#FF16213E" 
                                BorderThickness="2" 
                                CornerRadius="12" 
                                Margin="0,0,0,16"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" 
                                        Width="140" 
                                        Height="100" 
                                        CornerRadius="8"
                                        VerticalAlignment="Top"
                                        Margin="0,10,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF667EEA" Offset="0"/>
                                            <GradientStop Color="#FF764BA2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding IconEmoji}" 
                                               FontSize="48" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <!-- Header Row -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="18" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Type}" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="14" 
                                                       Foreground="#FFB8B8D1" 
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" 
                                                Background="{Binding StatusColor}" 
                                                CornerRadius="6" 
                                                Padding="12,6">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Size Info -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   Foreground="#FF8B8BA7">
                                            <Run Text="Size: "/>
                                            <Run Text="{Binding Size}"/>
                                            <Run Text=" MB"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   Foreground="#FF8B8BA7">
                                            <Run Text="{Binding Downloaded}"/>
                                            <Run Text=" MB / "/>
                                            <Run Text="{Binding Size}"/>
                                            <Run Text=" MB"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <Border Height="8" 
                                            Background="#FF2C2C44" 
                                            CornerRadius="4" 
                                            Margin="0,0,0,8">
                                        <Border CornerRadius="4" 
                                                HorizontalAlignment="Left" 
                                                Width="{Binding ProgressWidth}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF7C5CFF" Offset="0"/>
                                                    <GradientStop Color="#FFFF6B9D" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <!-- Progress Info -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   Foreground="#FF8B8BA7">
                                            <Run Text="{Binding Progress}"/>
                                            <Run Text="% complete"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Speed}" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="White"/>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding ActionButtonText}" 
                                                Style="{Binding ActionButtonStyle, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                Visibility="{Binding ActionButtonVisibility}"
                                                Tag="{Binding}"
                                                Padding="16,8"
                                                FontSize="14"
                                                Margin="0,0,12,0"/>

                                        <Button Content="🗑 Remove" 
                                                Style="{StaticResource ModernButton}"
                                                Tag="{Binding}"
                                                Padding="16,8"
                                                FontSize="14">
                                            <Button.Background>
                                                <SolidColorBrush Color="#FFEF4444"/>
                                            </Button.Background>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>

                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
