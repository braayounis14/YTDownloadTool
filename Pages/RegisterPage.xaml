<Page x:Class="YTDownloadTool.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YTDownloadTool.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage"
      Background="#0D0D15">
    <Page.Resources>
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2C2C44"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3A3A54"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF7C5CFF" Offset="0"/>
                        <GradientStop Color="#FFFF6B9D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#7C5CFF" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF0F0F1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF16213E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF7C5CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0F0F1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF16213E"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1A1A2E" Offset="0"/>
                <GradientStop Color="#FF0A0A0F" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#FF1A1A2E" Height="120">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="32,0">
                <TextBlock Text="Download Manager" 
                           FontFamily="Segoe UI" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="Active downloads and recordings" 
                           FontFamily="Segoe UI" 
                           FontSize="14" 
                           Foreground="#FFB8B8D1" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    Content="+ Add New Download" 
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,32,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Padding="24,12"></Button>
        </Grid>

        <!-- Downloads List -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Margin="32,32,32,32"
                      Background="Transparent">
            <ItemsControl x:Name="DownloadsListBox" Background="Transparent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF1A1A2E" 
                                BorderBrush="#FF16213E" 
                                BorderThickness="2" 
                                CornerRadius="12" 
                                Margin="0,0,0,16"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border Grid.Column="0" 
                                        Width="140" 
                                        Height="100" 
                                        CornerRadius="8"
                                        VerticalAlignment="Top"
                                        Margin="0,10,0,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF667EEA" Offset="0"/>
                                            <GradientStop Color="#FF764BA2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="{Binding IconEmoji}" 
                                               FontSize="48" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Content -->
                                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                    <!-- Header Row -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="18" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Type}" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="14" 
                                                       Foreground="#FFB8B8D1" 
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" 
                                                Background="{Binding StatusColor}" 
                                                CornerRadius="6" 
                                                Padding="12,6">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       FontFamily="Segoe UI" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>

                                    <!-- Size Info -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   Foreground="#FF8B8BA7">
                                            <Run Text="Size: "/>
                                            <Run Text="{Binding Size}"/>
                                            <Run Text=" MB"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   Foreground="#FF8B8BA7">
                                            <Run Text="{Binding Downloaded}"/>
                                            <Run Text=" MB / "/>
                                            <Run Text="{Binding Size}"/>
                                            <Run Text=" MB"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Progress Bar -->
                                    <Border Height="8" 
                                            Background="#FF2C2C44" 
                                            CornerRadius="4" 
                                            Margin="0,0,0,8">
                                        <Border CornerRadius="4" 
                                                HorizontalAlignment="Left" 
                                                Width="{Binding ProgressWidth}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#FF7C5CFF" Offset="0"/>
                                                    <GradientStop Color="#FFFF6B9D" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>

                                    <!-- Progress Info -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   Foreground="#FF8B8BA7">
                                            <Run Text="{Binding Progress}"/>
                                            <Run Text="% complete"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Speed}" 
                                                   FontFamily="Segoe UI" 
                                                   FontSize="13" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="White"/>
                                    </Grid>

                                    <!-- Action Buttons -->
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding ActionButtonText}" 
                                                Style="{Binding ActionButtonStyle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding ActionButtonVisibility}"
                                                Tag="{Binding}"
                                                Padding="16,8"
                                                FontSize="14"
                                                Margin="0,0,12,0"/>

                                        <Button Content="🗑 Remove" 
                                                Style="{StaticResource ModernButton}"
                                                Tag="{Binding}"
                                                Padding="16,8"
                                                FontSize="14">
                                            <Button.Background>
                                                <SolidColorBrush Color="#FFEF4444"/>
                                            </Button.Background>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                    x:Name="EmptyState"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <TextBlock Text="📥" 
                       FontSize="80" 
                       HorizontalAlignment="Center" 
                       Opacity="0.3"/>
            <TextBlock Text="No active downloads" 
                       FontFamily="Segoe UI" 
                       FontSize="20" 
                       Foreground="#FF4A4A6A" 
                       HorizontalAlignment="Center" 
                       Margin="0,16,0,0"/>
        </StackPanel>

        <!-- Add Download Dialog -->
        <Grid x:Name="ModalOverlay" 
              Grid.RowSpan="2" 
              Background="#B0000000" 
              Visibility="Collapsed">
            <Border Background="#FF1A1A2E" 
                    BorderBrush="#FF16213E" 
                    BorderThickness="2" 
                    CornerRadius="16" 
                    Width="400" 
                    Padding="32"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.7"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Add New Download" 
                               FontFamily="Segoe UI" 
                               FontSize="24" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               Margin="0,0,0,24"/>

                    <!-- File Name -->
                    <TextBlock Text="File Name" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Medium" 
                               Foreground="#FFB8B8D1" 
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="FileNameInput" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,20"/>

                    <!-- Type -->
                    <TextBlock Text="Type" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Medium" 
                               Foreground="#FFB8B8D1" 
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="TypeInput" 
                              Style="{StaticResource ModernComboBox}" 
                              Margin="0,0,0,20"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Video"/>
                        <ComboBoxItem Content="Live Recording"/>
                    </ComboBox>

                    <!-- Size -->
                    <TextBlock Text="Size (MB)" 
                               FontFamily="Segoe UI" 
                               FontSize="14" 
                               FontWeight="Medium" 
                               Foreground="#FFB8B8D1" 
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="SizeInput" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,24"/>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Cancel" 
                                Style="{StaticResource ModernButton}"
                                Padding="12"/>

                        <Button Grid.Column="2" 
                                Content="Start Download" 
                                Style="{StaticResource PrimaryButton}"
                                Padding="12"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
