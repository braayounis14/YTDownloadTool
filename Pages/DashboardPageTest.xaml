<Page x:Class="YTDownloadTool.Pages.DashboardPageTest"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:YTDownloadTool.Pages" xmlns:vm="clr-namespace:YTDownloadTool.ViewModels"
      mc:Ignorable="d" 
      Background="Transparent"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPageTest">

    <Page.DataContext>
        <vm:DashboardPageViewModel/>
    </Page.DataContext>

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="New Download" Foreground="White" FontSize="28" FontWeight="Bold"/>

            <Grid Margin="0,20,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}"
                         Background="#222"
                         Foreground="White"
                         FontSize="16"
                         Padding="8"
                         BorderThickness="0"/>

                <Button Grid.Column="1"
                        Content="DOWNLOAD"
                        Command="{Binding DownloadCommand}"
                        Background="#FF4081"
                        Foreground="White"
                        FontWeight="Bold"
                        Margin="10,0,0,0"/>
            </Grid>

            <TextBlock Text="Active Downloads" Foreground="#AAA" Margin="0,20,0,10" FontWeight="Bold"/>

            <ListView ItemsSource="{Binding Downloads}" Background="Transparent" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" Padding="8" Background="#1E1E1E" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding Job.Url}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar Maximum="100" Value="{Binding Job.Progress}" Height="18" Margin="0,5,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding Job.Speed}" Foreground="#AAA" Width="120"/>
                                    <TextBlock Text="{Binding Job.Eta}" Foreground="#AAA" Width="120"/>
                                    <TextBlock Text="{Binding Job.State}" Foreground="#AAA"/>
                                    <Button Content="Open" Command="{Binding OpenPathCommand}" Width="60" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
